# --- Application ---
APP_ENV=dev
JWT_SECRET=
APPROVAL_SECRET=
BOT_API_KEY=
DEMO_USERS_PASSWORD=
RATE_LIMIT_PER_MINUTE=30

# --- Données ---
DATABASE_URL=postgresql+psycopg://claimidoc:claimidoc@postgres:5432/claimidoc
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=claimidoc_v1
CORPUS_DIR=../data/corpus
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=claimidoc
POSTGRES_PASSWORD=

# --- Modèles ---
EMBEDDER=bge-m3
RERANKER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.0
LLM_MODE=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
VLM_MODE=stub
VLM_BASE_URL=http://localhost:8001/v1
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- MCP / Telegram / MLflow ---
MCP_URL=http://mcp:8765/mcp
MCP_DB_PATH=/data/mcp_claims.sqlite3
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://api:8000
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Frontend (serveur Next.js uniquement, jamais exposé au navigateur) ---
AUTH_SECRET=
FASTAPI_URL=http://api:8000
